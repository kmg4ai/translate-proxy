# --- language pair -----------------------------------------------------------
# USER_LANG = the language YOU write in; the model thinks in MODEL_LANG (en).
# Your text is translated USER_LANG -> MODEL_LANG, and the model's answer is
# translated back into YOUR language.
#
# Your language's short code (ISO 639-1) — find it below and set USER_LANG to
# it; that alone is enough.
#
#   pl Polish             en English            de German             fr French             es Spanish
#   it Italian            uk Ukrainian          ru Russian            cs Czech              nl Dutch
#   sv Swedish            da Danish             no Norwegian          fi Finnish            pt Portuguese
#   tr Turkish            hu Hungarian          ro Romanian           sk Slovak             bg Bulgarian
#   el Greek              hr Croatian           sr Serbian            lt Lithuanian         lv Latvian
#   et Estonian           sl Slovenian          zh Chinese            ja Japanese           ko Korean
#   ar Arabic             he Hebrew             hi Hindi              bn Bengali            ur Urdu
#   pa Punjabi            ta Tamil              te Telugu             mr Marathi            gu Gujarati
#   kn Kannada            ml Malayalam          ne Nepali             si Sinhala            th Thai
#   vi Vietnamese         id Indonesian         ms Malay              tl Filipino           km Khmer
#   my Burmese            lo Lao                mn Mongolian          jv Javanese           ceb Cebuano
#   mi Maori              haw Hawaiian          sm Samoan             fj Fijian             sw Swahili
#   am Amharic            ha Hausa              yo Yoruba             ig Igbo               zu Zulu
#   xh Xhosa              af Afrikaans          so Somali             mg Malagasy           wo Wolof
#   rw Kinyarwanda        sn Shona              st Sesotho            tn Tswana             ee Ewe
#   ak Akan               ti Tigrinya           om Oromo              fa Persian            ps Pashto
#   ku Kurdish            uz Uzbek              kk Kazakh             az Azerbaijani        hy Armenian
#   ka Georgian           tg Tajik              tk Turkmen            ky Kyrgyz             cy Welsh
#   ga Irish              gd Scottish Gaelic    mt Maltese            sq Albanian           mk Macedonian
#   be Belarusian         is Icelandic          bs Bosnian            ca Catalan            gl Galician
#   eu Basque             lb Luxembourgish      fy Frisian
#
# For a code NOT listed above, also set USER_LANG_NAME to its English name.
USER_LANG=pl
MODEL_LANG=en

# --- translator --------------------------------------------------------------
# TRANSLATOR is YOUR choice and it is authoritative.
# Default: direct DeepSeek API (needs DEEPSEEK_API_KEY).
# To translate via OpenRouter instead, set:
#   TRANSLATOR=openrouter TRANSLATOR_MODEL=deepseek/deepseek-v4-flash
#   (and OPENROUTER_API_KEY).
#
# Optional machine-translation backends (no model to pay):
#   TRANSLATOR=google              needs GOOGLE_TRANSLATE_API_KEY
#                                  (Cloud Translation v2; 500K chars/month free,
#                                  then ~$20 per million chars)
#   TRANSLATOR=libretranslate      self-hosted & free (Argos Translate); the
#                                  URL is LIBRETRANSLATE_BASE, key optional
#                                  (LIBRETRANSLATE_API_KEY)
#   TRANSLATOR=deepl               needs DEEPL_API_KEY (api-free.deepl.com/v2;
#                                  Pro endpoint via DEEPL_API_BASE)
#   TRANSLATOR=azure               needs AZURE_TRANSLATOR_KEY (+ region for
#                                  regional resources); 2M chars/month free
# TRANSLATOR_MODEL is ignored for machine backends — they take the raw text +
# language pair.
#
# TRANSLATOR_FALLBACK = explicit backup chain ("backend/model,backend/model").
# LLM backends keep an implicit OpenRouter safety net; machine-translation
# backends have NO implicit fallback (your choice is authoritative — a free pick
# never silently switches to a paid LLM). Set this only if you want a backup.
TRANSLATOR=deepseek
TRANSLATOR_MODEL=deepseek-v4-flash
TRANSLATOR_FALLBACK=

# --- behavior ----------------------------------------------------------------
TRANSLATE_HISTORY=true
CACHE_SIZE=500
GUARD_STOPWORD_RATIO=0.3
PLACEHOLDER=…
# Main models that pass through UNTRANSLATED (plain relay) because translation
# costs more than the English token saving on them. Substring match, so both
# bare names ("deepseek-v4-flash") and provider-prefixed ones
# ("deepseek/deepseek-v4-flash") are caught. Set to "" to translate for every
# model; add others as needed (comma-separated).
SKIP_TRANSLATION_MODELS=deepseek-v4-flash,deepseek-pro

# --- keys (keep out of git) --------------------------------------------------
# The proxy AUTO-LOADS this file (KEY=VALUE) — no `export` needed; keys you've
# already exported in your shell always win. Want keys encrypted at rest?
# See the optional block at the bottom.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=  # only needed if you translate via OpenRouter
GOOGLE_TRANSLATE_API_KEY=  # only needed if you translate via Google (TRANSLATOR=google)
LIBRETRANSLATE_API_KEY=  # only if your LibreTranslate instance requires a key
LIBRETRANSLATE_BASE=http://127.0.0.1:5000
DEEPL_API_KEY=  # only needed if you translate via DeepL (TRANSLATOR=deepl)
DEEPL_API_BASE=https://api-free.deepl.com/v2  # set to https://api.deepl.com/v2 for a Pro account
AZURE_TRANSLATOR_KEY=  # only needed if you translate via Azure (TRANSLATOR=azure)
AZURE_TRANSLATOR_REGION=  # e.g. westeurope — required by regional Azure resources

# --- optional: encrypt this file ---------------------------------------------
# Protect keys at rest so a leaked file is useless. Requires the optional
# `cryptography` package:  pip install cryptography
#   python3 translate_proxy.py --make-env-enc    # writes .env.enc (prompts for a passphrase)
#   rm .env                                      # leave only the ciphertext
#   ENV_PASSPHRASE=... python3 translate_proxy.py --upstream http://127.0.0.1:8799
# The proxy decrypts .env.enc IN MEMORY, never writing plaintext back to disk.
# To edit keys later:  python3 translate_proxy.py --env-decrypt
